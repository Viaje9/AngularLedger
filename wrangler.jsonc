{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "angular-ledger-staging",
  "account_id": "80c54a9294e508bb1f92c6b4f58be37f",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./dist/angular-ledger/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "angular-ledger-staging",
      "database_id": "e66b32b4-76fe-4302-97a7-9820650dd9ad",
      "migrations_dir": "migrations"
    }
  ]
}
