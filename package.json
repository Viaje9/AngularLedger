{
  "name": "angular-ledger",
  "version": "0.0.7",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build --base-href /",
    "watch": "ng build --watch --configuration development",
    "api:generate": "openapi-ts",
    "api:check": "tsc -p worker/tsconfig.json --noEmit",
    "api:test": "node --test --experimental-sqlite tests/worker-api.test.mjs",
    "build:cloudflare": "npm run build",
    "ci:cloudflare": "npm run api:check && npm run api:test && npm run build:cloudflare",
    "dev:worker": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply angular-ledger-staging --local",
    "test": "ng test",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.25",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.25",
    "@angular/compiler": "^19.2.25",
    "@angular/core": "^19.2.25",
    "@angular/forms": "^19.2.25",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.25",
    "@angular/platform-browser-dynamic": "^19.2.25",
    "@angular/router": "^19.2.25",
    "@angular/service-worker": "^19.2.25",
    "@ngneat/until-destroy": "^10.0.0",
    "d3": "^7.8.5",
    "dayjs": "^1.11.10",
    "hammerjs": "^2.0.8",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.5",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.25",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/d3": "^7.4.3",
    "@types/hammerjs": "^2.0.45",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.4.17",
    "esbuild": "^0.28.2",
    "husky": "^9.1.6",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.8.3",
    "wrangler": "^4.141.0"
  }
}
